# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
APP_URL=http://localhost:3000
# Comma-separated exact additional origins, e.g. a specific preview deployment.
ALLOWED_ORIGINS=
