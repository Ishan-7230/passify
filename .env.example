# Passify Environment Configuration
# Copy this file to .env.local and populate the secrets.

# Required: Secret used to cryptographically sign session cookies and password recovery tokens.
# Must be at least 32 characters long.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_32_plus_char_secret_here_e.g._53d7a9f7a7b2ea6ac00ac7b3b039590e430d9750d3d3ec748833e001f24f01b9

# Public application URL (used for verification URLs and callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Supabase configuration (if migrating from local JSON store to managed Supabase database)
# NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
